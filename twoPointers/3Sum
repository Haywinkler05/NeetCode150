class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        vector<vector<int>> ans;

        sort(nums.begin(), nums.end()); //Sort the numbers arr
        for(int i = 0; i < nums.size(); i++){ //Needs to check every value
            if(i > 0 && nums[i] == nums[i-1]) continue; //Duplicate check
            int left = i+1; int right = nums.size()-1; 
            while(left < right){
                int val = nums[i] + nums[left] + nums[right]; 
                if(val == 0){
                    ans.push_back({nums[i], nums[left], nums[right]});
                    left++;
                    right--;
                    while(left < right &&  nums[left] == nums[left-1] )left++; //Dup check
                }else if(val > 0){
                    right--;
                }else{
                    left++;
                }
            }
        }
        
        return ans; //Complexity O(N^2)
    }
};
